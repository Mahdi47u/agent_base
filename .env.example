DJANGO_SECRET_KEY=change-me-in-real-environments
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3100

AGENT_ENABLED=true
AGENT_PROVIDER=mock
AGENT_APPROVED_PROVIDERS=mock,openai
AGENT_SYSTEM_PROMPT=You are a concise, trustworthy assistant. Use tools for live data. Never claim a write succeeded unless an approved action result proves it.
AGENT_HISTORY_LIMIT=40
AGENT_MAX_SESSIONS=50
AGENT_ACTION_TTL_SECONDS=600
AGENT_PROVIDER_TIMEOUT_SECONDS=45

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=

BACKEND_URL=http://backend:8000
